################################################################################
###########################Add torch_memory_saver###############################
################################################################################
# 修复 hipcc/clang++ 参数问题：创建 clang++ wrapper 过滤错误的分号分隔参数
RUN cp /opt/rocm/lib/llvm/bin/clang++ /opt/rocm/lib/llvm/bin/clang++.original && \
    cat > /opt/rocm/lib/llvm/bin/clang++ <<'EOF'
#!/bin/bash
args=()
for arg in "$@"; do
    case "$arg" in
        --amdgpu-target=*';'*)
            continue
            ;;
    esac
    args+=("$arg")
done
exec /opt/rocm/lib/llvm/bin/clang++.original "${args[@]}"
EOF
RUN chmod +x /opt/rocm/lib/llvm/bin/clang++

# 注意：不要在环境变量中使用分号分隔 GPU 架构！
# 错误: HIPCC_COMPILE_FLAGS_APPEND="--amdgpu-target=gfx90a;gfx942"
# 正确: 只指定一个架构，或在代码层面通过 --offload-arch 指定
ENV HIPCC_COMPILE_FLAGS_APPEND="-D__HIP_PLATFORM_AMD__"
ENV CFLAGS="-D__HIP_PLATFORM_AMD__"
ENV CXXFLAGS="-D__HIP_PLATFORM_AMD__"
RUN pip install "git+https://github.com/YangWang92/torch_memory_saver_numa.git@numa"
