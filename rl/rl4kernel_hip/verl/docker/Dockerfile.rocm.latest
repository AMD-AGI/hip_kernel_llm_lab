###########################################
##########Install TransformerEngine########
###########################################
WORKDIR /workspace/
RUN rm -rf TransformerEngine
RUN git clone --recursive https://github.com/ROCm/TransformerEngine.git
WORKDIR /workspace/TransformerEngine

# 固定到你指定的 TE 版本
RUN git checkout 236178e5

# 关键：checkout 之后立刻同步并初始化所有子模块（递归）
RUN git submodule sync --recursive \
 && git submodule update --init --recursive

# Sanity check：这个 generate.py 必须存在；不存在就兜底手动植入 CK
#（某些分支/commit 可能未把 CK 作为子模块，或子模块指向路径变动）
RUN if [ ! -f "3rdparty/composable_kernel/example/ck_tile/01_fmha/generate.py" ]; then \
      echo "CK submodule missing. Injecting CK into 3rdparty/composable_kernel ..."; \
      mkdir -p 3rdparty && rm -rf 3rdparty/composable_kernel && \
      git clone https://github.com/ROCm/composable_kernel.git 3rdparty/composable_kernel && \
      cd 3rdparty/composable_kernel && \
      # 选择一个与 ROCm-6.3.x 协调的稳定版本（包含 example/ck_tile/01_fmha）
      # 若你的镜像是 6.3.4，可优先 rocm-6.3 分支或 2024 年中后期的 tag
      # 可换成具体 tag: rocm-6.3 或 v6.3.x；下面示例使用 develop 也可行，但更推荐 rocm-6.3
      git checkout rocm-6.3 || git checkout develop; \
      git submodule update --init --recursive; \
    fi

# 再次确保脚本在位（否则直接失败，方便你排查）
RUN test -f 3rdparty/composable_kernel/example/ck_tile/01_fmha/generate.py

# 建议补齐 ninja（CMake 默认 -GNinja）
RUN apt-get update && apt-get install -y ninja-build

# 编译期环境：保留 CK fused-attn 后端
ENV NVTE_FRAMEWORK=pytorch
ENV NVTE_ROCM_ARCH=gfx942
ENV NVTE_USE_HIPBLASLT=1
ENV NVTE_USE_ROCM=1
ENV NVTE_FUSED_ATTN=1
ENV NVTE_FUSED_ATTN_CK=1
# AOTriton 也可同时保留
ENV NVTE_FUSED_ATTN_AOTRITON=1

# 让 CMake 能找到 ROCm
ENV CMAKE_PREFIX_PATH="/opt/rocm:/opt/rocm/hip:/usr/local:/usr"

# （可选）把 CMP0135 设为 NEW，避免 ExternalProject 时间戳警告
ENV CMAKE_ARGS="-DCMAKE_POLICY_DEFAULT_CMP0135=NEW"

# 一些 CK/hip 编译链在 6.3 上对目标架构更“敏感”，提前告诉 hipcc
#（若你稍前就设置了 HIPCC_COMPILE_FLAGS_APPEND/AMDGPU_TARGETS，可复用）
ENV HIPCC_COMPILE_FLAGS_APPEND="--offload-arch=gfx942"
ENV AMDGPU_TARGETS=gfx942

# 重要：MAX_JOBS 的写法要用 ${MAX_JOBS} 而不是 $(MAX_JOBS)
# 并建议关闭 build isolation，避免 pip build 隔离掉我们注入的 3rdparty/CK
RUN MAX_JOBS=${MAX_JOBS} pip install --no-build-isolation . -vvv

