flowchart TB
    subgraph D0["<span style='font-size:26px;font-weight:800;'>Plan A: Only Rewrite Functional Code</span>"]
      direction TB

      subgraph D1["<span style='font-size:22px;font-weight:800;'>Dataset Layer</span>"]
        direction TB
        A0["<div style='width:320px;padding:10px 12px;line-height:1.45;text-align:left;'><b>Real training data</b><br/><span style='font-family:monospace'>rl_data_v01_mi325x_react_verl.parquet</span></div>"]
        A1["<div style='width:320px;padding:10px 12px;line-height:1.45;text-align:left;'><b>Parquet rewrite</b><br/>clone rows by test case<br/>rewrite <span style='font-family:monospace'>reward_model.ground_truth.pytorch_functional_code</span></div>"]
        A2["<div style='width:320px;padding:10px 12px;line-height:1.45;text-align:left;'><b>Config remains hidden in code</b><br/>shape, tensor size, init inputs stay inside<br/><span style='font-family:monospace'>get_inputs()</span> and <span style='font-family:monospace'>get_init_inputs()</span></div>"]
        A0 --> A1 --> A2
      end

      subgraph D2["<span style='font-size:22px;font-weight:800;'>Request Path</span>"]
        direction TB
        A3["<div style='width:320px;padding:10px 12px;line-height:1.45;text-align:left;'><b>Reward layer</b><br/><span style='font-family:monospace'>reward.py</span> and <span style='font-family:monospace'>reward_batch.py</span><br/>forward code string unchanged</div>"]
        A4["<div style='width:320px;padding:10px 12px;line-height:1.45;text-align:left;'><b>EvalRequest unchanged</b><br/>no new schema field<br/>existing request payload is enough</div>"]
        A2 --> A3 --> A4
      end

      subgraph D3["<span style='font-size:22px;font-weight:800;'>Sandbox Execution</span>"]
        direction TB
        A5["<div style='width:320px;padding:10px 12px;line-height:1.45;text-align:left;'><b>Codegen unchanged</b><br/>append functional code into generated<br/>sandbox unittest driver</div>"]
        A6["<div style='width:320px;padding:10px 12px;line-height:1.45;text-align:left;'><b>Runtime executes test</b><br/>call <span style='font-family:monospace'>get_inputs()</span><br/>compile candidate, run candidate, compare, benchmark</div>"]
        A4 --> A5 --> A6
      end

      subgraph D4["<span style='font-size:22px;font-weight:800;'>Cache Behavior</span>"]
        direction TB
        A7["<div style='width:320px;padding:10px 12px;line-height:1.45;text-align:left;'><b>Cache identity reused</b><br/>different functional code naturally produces<br/>different golden and perf cache keys</div>"]
        A8["<div style='width:320px;padding:10px 12px;line-height:1.45;text-align:left;'><b>Operational meaning</b><br/>1 config = 1 parquet row = 1 request = 1 benchmark case</div>"]
        A6 --> A7 --> A8
      end
    end

    N1["<div style='width:360px;padding:10px 12px;line-height:1.45;text-align:left;'><b>Files usually touched</b><br/><span style='font-family:monospace'>dataset/kernel-agent-single-sft-1125/convert_to_verl_parquet.py</span><br/>or a new parquet postprocess script in the same directory</div>"]
    N2["<div style='width:360px;padding:10px 12px;line-height:1.45;text-align:left;'><b>Files usually not touched</b><br/><span style='font-family:monospace'>reward/reward.py</span><br/><span style='font-family:monospace'>reward/reward_batch.py</span><br/><span style='font-family:monospace'>sandbox_core/protocol.py</span><br/><span style='font-family:monospace'>sandbox_core/codegen.py</span><br/><span style='font-family:monospace'>sandbox_core/reference.py</span><br/><span style='font-family:monospace'>sandbox_core/cache.py</span></div>"]

    A1 -.-> N1
    A7 -.-> N2

